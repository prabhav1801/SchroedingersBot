<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>schrodingers_bot</name>
  <version>1.0.0</version>
  <description>Vision-driven vehicle teleoperation and state-transition simulation via ROS 2 and OpenCV.</description>
  <maintainer email="prabhavsharma10@gmail.com">Prabhav Sharma</maintainer>
  <license>MIT</license>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
